{
  "name": "greencode-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend analitico e API publica do Greencode",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:all": "concurrently -k -n API,WEB,WORKER \"npm:dev:api\" \"npm:dev:client\" \"npm:dev:worker\"",
    "dev:client": "vite --config client/vite.config.ts --host 0.0.0.0",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "npm run build:client && tsc",
    "build:client": "vite build --config client/vite.config.ts",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "start:all": "concurrently -k -n API,WORKER \"npm:start\" \"npm:start:worker\"",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.1.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@prisma/client": "^6.19.0",
    "bullmq": "^5.34.10",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "concurrently": "^9.1.2",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vite": "^6.1.0"
  }
}
