{
  "name": "greencode-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de logística reversa do greencode",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc",
    "start": "node dist/servidor.js",
    "test": "tsx --test testes/*.test.ts",
    "preparar": "npm run banco:gerar && npm run banco:migrar -- --name inicial && npm run banco:seed",
    "banco:gerar": "prisma generate",
    "banco:migrar": "prisma migrate dev",
    "banco:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "6.12.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}